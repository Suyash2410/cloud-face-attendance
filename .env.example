# Haazri Environment Configuration

# Run Mode: "true" for Mock Mode (zero-AWS offline demo), "false" for Live Mode (real AWS)
VITE_USE_MOCK=true

# Live Mode AWS Configuration (only needed when VITE_USE_MOCK=false)
VITE_AWS_REGION=ap-southeast-2
VITE_COGNITO_USER_POOL_ID=ap-southeast-2_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-southeast-2.amazonaws.com
VITE_S3_PHOTO_BUCKET=haazri-photos-xxxxxxxxx-ap-southeast-2
VITE_REKOGNITION_COLLECTION_ID=haazri-faces

# Mock Server Port (optional standalone mode)
PORT=4000
